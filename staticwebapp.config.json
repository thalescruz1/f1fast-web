{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/*.css",
      "/*.js",
      "/*.ico",
      "/*.png",
      "/*.svg",
      "/*.webmanifest",
      "/*.json",
      "/*.txt",
      "/*.woff2"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
